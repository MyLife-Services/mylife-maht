{
  "name": "mylife-maht",
  "version": "1.0.0",
  "description": "Maht is a an openai model trained on MyLife corporate private and public materials to assist the Board of Directors for MyLife in governance and growth of the organization in ethical, honest, transparent and impactful ways",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start-dev": "dotenv -e .env server.js",
    "dev": "dotenv -e .env nodemon server.js"
  },
  "nodemonConfig": {
    "ignore": [
      "*.env",
      "*.env-sample",
      "*.md",
      "*.yaml",
      ".gitignore",
      ".git/*",
      "views/*",
      "inc/js/deprecated/*",
      "inc/json-schemas/in-progress/*"
    ],
    "watch": [
      "server.js",
      "inc/js/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MyLife-Services/mylife-maht.git"
  },
  "keywords": [
    "ai",
    "governance",
    "mylife",
    "hrp",
    "board",
    "directors",
    "executive",
    "assistant",
    "agent",
    "maht"
  ],
  "author": "MyLife",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MyLife-Services/mylife-maht/issues"
  },
  "homepage": "https://github.com/MyLife-Services/mylife-maht#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.56.0",
    "@azure/cosmos": "^4.4.1",
    "@azure/identity": "^4.10.2",
    "@koa/cors": "^5.0.0",
    "@modelcontextprotocol/sdk": "^1.15.0",
    "ajv": "^8.17.1",
    "chalk": "^5.4.1",
    "form-data": "^4.0.3",
    "js-guid": "^1.0.2",
    "koa": "^3.0.0",
    "koa-body": "^6.0.1",
    "koa-connect": "^2.1.0",
    "koa-ejs": "^4.3.0",
    "koa-generic-session": "^2.3.1",
    "koa-mount": "^4.2.0",
    "koa-router": "^13.1.1",
    "koa-static": "^5.0.0",
    "marked": "^16.0.0",
    "nodemailer": "^7.0.4",
    "openai": "^4.87.3"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "nodemon": "^3.1.10"
  }
}
