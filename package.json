{
  "name": "c4rg-intelligent-platform",
  "version": "0.1.0",
  "description": "This codebase, taken from MyLife's Platform servver, has been adapted for Citizens for Rational Government (C4RG) to create an intelligent platform that leverages AI technologies to engage visitors with: 1) Information about the organization, 2) express and debate majoritarian positions held by the preponderance of American citizens.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node bootstrap.js",
    "dev": "npm i && nodemon bootstrap.js"
  },
  "nodemonConfig": {
    "ignore": [
      "*.env",
      "*.env-sample",
      "*.md",
      "*.yaml",
      ".gitignore",
      ".git/*",
      "views/*",
      "inc/js/deprecated/*",
      "inc/json-schemas/*"
    ],
    "watch": [
      "bootstrap.js",
      "server.js",
      "inc/js/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citizens-for-Rational-Government/C4RG-intelligent-platform.git"
  },
  "keywords": [
    "ai",
    "governance",
    "citizens for rational government",
    "board",
    "directors",
    "executive",
    "assistant",
    "agent"
  ],
  "author": "Citizens for Rational Government",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Citizens-for-Rational-Government/C4RG-intelligent-platform/issues"
  },
  "homepage": "https://github.com/Citizens-for-Rational-Government/C4RG-intelligent-platform#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.87.0",
    "@azure/cosmos": "^4.9.2",
    "@azure/identity": "^4.10.2",
    "@huggingface/transformers": "^4.0.1",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.4.0",
    "@modelcontextprotocol/sdk": "^1.15.0",
    "chalk": "^5.4.1",
    "dotenv": "^16.4.5",
    "koa": "^3.2.0",
    "koa-body": "^6.0.1",
    "koa-connect": "^2.1.0",
    "koa-generic-session": "^2.3.1",
    "koa-mount": "^4.2.0",
    "koa-static": "^5.0.0",
    "marked": "^16.0.0",
    "nodemailer": "^8.0.5",
    "openai": "^6.33.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "deprecatedDependencies": {
    "ajv": "^8.17.1",
    "dotenv-cli": "^8.0.0",
    "form-data": "^4.0.3",
    "js-guid": "^1.0.2",
    "koa-router": "^13.1.1"
  }
}
