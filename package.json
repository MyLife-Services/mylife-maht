{
  "name": "c4rg-intelligent-platform",
  "version": "0.1.0",
  "description": "This codebase, taken from MyLife's Platform servver, has been adapted for Citizens for Rational Government (C4RG) to create an intelligent platform that leverages AI technologies to engage visitors with: 1) Information about the organization, 2) express and debate majoritarian positions held by the preponderance of American citizens.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start-dev": "dotenv -e .env server.js",
    "dev": "dotenv -e .env nodemon server.js"
  },
  "nodemonConfig": {
    "ignore": [
      "*.env",
      "*.env-sample",
      "*.md",
      "*.yaml",
      ".gitignore",
      ".git/*",
      "views/*",
      "inc/js/deprecated/*",
      "inc/json-schemas/in-progress/*"
    ],
    "watch": [
      "server.js",
      "inc/js/*",
      "inc/json-schemas/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citizens-for-Rational-Government/C4RG-intelligent-platform.git"
  },
  "keywords": [
    "ai",
    "governance",
    "citizens for rational government",
    "board",
    "directors",
    "executive",
    "assistant",
    "agent"
  ],
  "author": "Citizens for Rational Government",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Citizens-for-Rational-Government/C4RG-intelligent-platform/issues"
  },
  "homepage": "https://github.com/Citizens-for-Rational-Government/C4RG-intelligent-platform#readme",
  "dependencies": {
    "@azure/cosmos": "^4.2.0",
    "@azure/identity": "^4.8.0",
    "@koa/cors": "^5.0.0",
    "@modelcontextprotocol/sdk": "^1.9.0",
    "ajv": "^8.17.1",
    "form-data": "^4.0.2",
    "koa": "^2.16.0",
    "koa-body": "^6.0.1",
    "koa-connect": "^2.1.0",
    "koa-generic-session": "^2.3.1",
    "koa-mount": "^4.0.0",
    "koa-router": "^13.0.1",
    "koa-static": "^5.0.0",
    "marked": "^15.0.7",
    "nodemailer": "^6.10.1",
    "openai": "^4.87.3"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "nodemon": "^3.1.9"
  },
  "disabledDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "koa-ejs": "^4.3.0"
  }
}
