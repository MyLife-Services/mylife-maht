# MyLife Synthetic Testing — Playbook Environment
# Copy this file to playbook.env (same directory) and fill in real values.
# playbook.env is gitignored (.env* pattern in root .gitignore).
#
# All playbooks in this directory read this file for shared credentials.
# Variable references in YAML appear as ${VAR_NAME}.

MYLIFE_BASE_URL=https://mylife.ngrok.app
SYNTHETIC_MBR_ID=avatarName|your-member-uuid-here
SYNTHETIC_PASSPHRASE=your passphrase here
