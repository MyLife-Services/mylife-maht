{
    "annotations": {
        "title": "MyLife-Switch-Bot",
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false
    },
	"description": "I can switch you to a different active MyLife bot intelligence, given the bot function.",
	"inputSchema": {
        "type": "object",
		"properties": {
            "team": {
                "default": "memory",
				"description": "Team to which bot belongs, default is `memory`.",
				"enum": ["unknown", "memory", "health", "career", "art", "other"],
				"type": "string"
			},
			"type": {
                "default": "avatar",
				"description": "The type of bot to switch to",
				"type": "string"
			}
		},
		"required": [
            "type"
        ]
	},
    "name": "switch_bot",
    "mylife_bots": [
        "any"
    ]
}