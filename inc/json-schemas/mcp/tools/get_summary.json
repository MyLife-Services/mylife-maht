{
	"annotations": {
		"title": "MyLife-Get-Summary",
		"readOnlyHint": false,
		"destructiveHint": true,
		"idempotentHint": true,
		"openWorldHint": false
	},
    "description": "I get an item's summary from the MyLife database by a given itemId",
    "inputSchema": {
        "type": "object",
        "properties": {
            "itemId": {
                "description": "Id of item summary to get",
                "type": "string"
            }
        },
        "required": [
            "itemId"
        ]
    },
    "mylife_bots": [
        "avatar",
        "biographer",
        "diary",
        "journal"
    ],
    "name": "get_summary",
    "outputSchema": {
        "type": "object",
        "properties": {
            "summary": {
                "description": "Summary of the item",
                "type": "string"
            }
        },
        "required": ["summary"]
    }
}