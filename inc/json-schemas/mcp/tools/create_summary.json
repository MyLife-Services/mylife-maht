                "type": "string"
            },
            "phaseOfLife": {
                "description": "Phase of life, if indicated by `item` content",
                "enum": [
                    "birth",
                    "childhood",
                    "adolescence",
                    "teenage",
                    "young-adult",
                    "adulthood",
                    "middle-age",
                    "senior",
                    "end-of-life",
