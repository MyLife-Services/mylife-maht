{
    "description": "Gets the `stance` summary by itemId",
    "name": "getStance",
    "parameters": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
            "itemId": {
                "description": "Id of `stance` summary to retrieve from server",
                "type": "string"
            },
            "summaryOnly": {
                "default": true,
                "description": "Whether to return only the `stance` summary text or the full `item` document with summary and metadata",
                "type": "boolean"
            }
        },
        "required": [
            "itemId",
            "summaryOnly"
        ]
    },
    "strict": true
}