{
  "name": "getInterests",
  "description": "Returns the most recent and current interests of a member human. Supports filtering by type and pagination.",
  "examples": {
    "input": {
      "mbr_id": "Squaz-gnocchi|b6f324da-3382-41b1-b80a-1b1421cf1d08",
      "interest_type": "personal",
      "limit": 25
    },
    "output": {
      "mbr_id": "Squaz-gnocchi|b6f324da-3382-41b1-b80a-1b1421cf1d08",
      "interests": ["storytelling", "restorative design", "interfaith rituals"]
    }
  },
  "agent": "nanda",
  "input": {
    "type": "object",
    "properties": {
      "interest_type": {
        "type": "string",
        "enum": ["all", "current", "personal", "professional"],
        "default": "current"
      },
      "limit": {
        "type": "integer",
        "default": 100
      },
      "mbr_id": {
        "type": "string"
      }
    },
    "required": ["limit", "mbr_id"]
  },
  "metadata": {
      "aliases": {
        "getCurrentInterests": {
          "proxyFor": "getInterests",
          "defaultInput": { "interest_type": "current" }
        },
        "getPersonalInterests": {
          "proxyFor": "getInterests",
          "defaultInput": { "interest_type": "personal" }
        },
        "getProfessionalInterests": {
          "proxyFor": "getInterests",
          "defaultInput": { "interest_type": "professional" }
        },
        "getAllInterests": {
          "proxyFor": "getInterests",
          "defaultInput": { "interest_type": "all" }
        }
      }
  },
  "output": {
    "type": "object",
    "properties": {
      "mbr_id": { "type": "string" },
      "interests": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "required": ["mbr_id", "interests"]
  },
  "preferredProviders": ["nanda", "mylife"],
  "protocol": "http/1.1",
  "version": "1.0.0"
}
