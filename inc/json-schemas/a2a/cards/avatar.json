  "skills": [
    {
      "description": "Activates a specific MyLife agent by its ID, allowing the user to interact with that agent.",
      "examples": ["Send me to my biographer", "Activate my personal avatar."],
      "id": "activateAgent",
      "inputs": [
        {
          "default": "avatar",
          "description": "The unique type of MyLife agent to activate.",
          "enum": ["avatar", "biographer", "diary", "journaler", "other"],
          "id": "type",
          "required": true,
          "type": "string"
        }
      ],
      "inputModes": ["application/json", "text/plain"],
      "name": "Activate Specific MyLife Agent",
      "outputModes": ["application/json", "text/plain"],
      "outputs": [
        {
          "description": "The ID of the activated agent.",
          "id": "activateAgentSuccess",
          "type": "boolean",
          "required": true
        }
      ],
      "tags": ["agent", "activation", "activate"]
    }
  ],
  "supportsAuthenticatedExtendedCards": true,
