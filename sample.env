APPLICATIONINSIGHTS_CONNECTION_STRING=disabled # Azure standard: your_connection_string_here for Microsoft Application Insights, or absent/empty string/'disabled' to ignore
APPLICATIONINSIGHTS_INTERNAL_LOGGING=false # set to true to enable verbose logging from Application Insights SDK, useful for debugging telemetry issues
OPENAI_API_CHAT_TIMEOUT=59000
OPENAI_API_CHAT_RESPONSE_PING_INTERVAL=890
OPENAI_API_KEY=sk-... # add your key here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_JWT_SECRETS={} # object with keys being JWT share with external AIs
OPENAI_MAHT_GITHUB=https://github.com/MyLife-Services/mylife-maht.git
OPENAI_MAHT_GPT_OVERRIDE=asst_... # local dev override for engine so that local can use chaper model
OPENAI_MAX_INSTRUCTIONS_LENGTH=256000 # max length of instructions to send to OpenAI
OPENAI_MODEL_CORE_AVATAR=gpt-4o-mini
OPENAI_MODEL_CORE_BOT=gpt-4o-mini
OPENAI_ORG_KEY= # org ID
PORT=3000
MYLIFE_ALLOW_INTELLIGENT_QUESTIONS=false # almost deprecated, leave false
MYLIFE_DB_ALLOW_SAVE=false # during local testing, so not write to db
MYLIFE_DB_CONTAINER_NAME=members
MYLIFE_DB_CONTAINER_NAME_CAMPAIGNS= # get from admin
MYLIFE_DB_CONTAINER_NAME_REGISTRATION= # get from admin
MYLIFE_DB_CONTAINER_NAME_SHARES= # get from admin
MYLIFE_DB_CONTAINER_NAME_SYSTEM= # get from admin
MYLIFE_DB_ENDPOINT=https://c4rg-cosmos-serverless.documents.azure.com:443/
MYLIFE_DB_NAME=c4rg-production
MYLIFE_DB_RW=string # add your key here
MYLIFE_SERVER_MBR_ID=c4rg|... # add your key here
MYLIFE_HOSTING_KEY=uuid # add your guid key here
MYLIFE_HOSTED_MBR_ID=[] # array of ids hosted on your server--OR--remove or leave empty for db host under full database container
MYLIFE_ORIGIN=https:// # or your local dev URL
MYLIFE_SESSION_KEY=0.2.0 # random string for resetting sessions
MYLIFE_SESSION_TIMEOUT_MS=900000
MYLIFE_SYSTEM_ALERT_CHECK_INTERVAL=120000 # how often to check for alerts in ms
MAHT_EMAIL= # get from admin
MAHT_EMAIL_PASSWORD= # get from admin
MCP_CLIENT_TOOLS=elicitation, sampling, roots # tools to enable for MCP client
MCP_JSONRPC_Version=2.0
MCP_JSONRPC_Protocol=2025-03-26
MCP_PAGE_SIZE=100 # cursor and pagination for MCP specifically
MCP_SAMPLING_TOKEN_MAX=1000 # max number of tokens for sampling
NANDA_REGISTRY_USER= # get from admin
NANDA_REGISTRY_PASSWORD= # get from admin
NANDA_REGISTRY_URL=https://nanda-registry.com/api/v1
